# Copy to .env for a local or test deployment. Keep this file free of secrets.
DJANGO_SECRET_KEY=replace-with-a-random-value-at-least-50-characters
DJANGO_DEBUG=1
PLM_PRODUCTION=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=partflow
POSTGRES_USER=partflow
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_VOLUME_NAME=partflow_v15_postgres_data
WEB_PORT=8000
PARTFLOW_NETWORK=partflow_net
REDIS_URL=redis://redis:6379/1

# Internal authenticated S3 API used by backend workers. Use an internal DNS name or address.
MINIO_S3_CONTROL_ENDPOINT=http://minio.internal.example:9000
# Public HTTPS S3 API used in presigned browser URLs; keep it distinct from the control endpoint.
MINIO_S3_PUBLIC_ENDPOINT=https://s3-api.example.com
# MinIO Console origin used for browser navigation.
MINIO_CONSOLE_URL=https://s3-console.example.com
MINIO_CONSOLE_ENDPOINT=https://s3-console.example.com
MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-minio-secret-key
MINIO_S3_REGION=us-east-1
MINIO_BUCKET_QUARANTINE=plm-quarantine-lab
MINIO_BUCKET_DRAFT=plm-draft-lab
MINIO_BUCKET_RELEASE=plm-release-lab
MINIO_BUCKET_EXPORT=plm-export-lab

LDAP_ENABLED=0
LDAP_HOST=ldap.internal.example
LDAP_PORT=389
LDAP_UID=sAMAccountName
LDAP_BIND_DN=
LDAP_PASS=
LDAP_BASE=

PLM_MAX_UPLOAD_BYTES=5368709120
FINALIZE_SYNC_THRESHOLD=5
AUTO_MIGRATE=1
AUTO_COLLECTSTATIC=1
LOG_LEVEL=INFO